# Copie para .env (o script scripts/db-setup.ps1 faz isso e gera as senhas sozinho).
# O arquivo .env NUNCA vai para o Git.

NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Banco de dados (MariaDB, compatível com MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_dev
DB_NAME_TEST=erp_test
DB_USER=erp_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Usada só pelos scripts de setup/stop do banco local. A aplicação nunca usa o root.
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# Sessão e login
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Senhas iniciais dos usuários de demonstração (trocadas no primeiro login)
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_AUDITOR_PASSWORD=CHANGE_ME_AUDITOR_PASSWORD
