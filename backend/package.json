{
  "name": "@erp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/scripts/migrate.js latest",
    "migrate:rollback": "node src/scripts/migrate.js rollback",
    "seed": "node src/scripts/seed.js",
    "demo:data": "node src/scripts/demo-data.js",
    "db:reset": "node src/scripts/migrate.js reset && node src/scripts/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "mysql2": "^3.14.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "vitest": "^3.1.3"
  }
}
